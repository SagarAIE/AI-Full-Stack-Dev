def search_prodcuts(brand: str+None, category: str = None);
"""Search available products by brand or category from the database."""
conn= sqlite3.connect(DB_NAME)
cursor= conn.cursor()
query="SELCTC name, brand, category, price, stock from products where 1=1"
params=[]
if brand:
query +="AND brand LIKE ?"
params.append(f"%{brand}%")
if category:
query +="AND category LIKE ?"
params.append(f"%{category}%")
cursor.execute(query, params)
rows=cursor.fetchall()
conn.close()
if not rows:
return "No products found match your criteria."
return [{"name": r[0],"brand": r[1], "category": r[2], "price": r[3], "stock": r[4]} for rin rows]

